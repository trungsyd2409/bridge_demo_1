# Bộ câu hỏi thử trợ lý AI. Mỗi dòng một JSON; dòng bắt đầu bằng # là chú thích.
#
# expect có thể gồm:
#   intent, risk, urgent, mode         nhãn phân loại
#   source                             ÍT NHẤT một nguồn được trích khớp regex
#   sourceAll                          MỌI nguồn được trích phải khớp regex  (bắt trích tài liệu lạc chủ đề)
#   grounding / notInsufficient        mức grounding
#   contains / notContains             regex phải / không được xuất hiện trong câu trả lời
#   noBareMoney                        nêu số tiền thì bắt buộc có trích dẫn và không được khai "chưa đủ nguồn"
#
# Thêm câu mới mỗi khi phát hiện trợ lý trả lời sai: bộ này sẽ bắt lỗi nếu nó quay lại.
# Con số đối chiếu: lương tối thiểu quốc gia $26.44/giờ, casual $33.05/giờ (wages.ts).

# ============ Trả thiếu lương ============
{"id": "pay1", "message": "Chủ không đưa payslip, trả tiền mặt", "expect": {"intent": "no_payslip", "urgent": false, "source": "pay ?slip", "sourceAll": "pay ?slip|record|wage|pay"}}
{"id": "pay2", "message": "Chủ trả em 18 đô một giờ, làm casual ở nhà hàng có đúng không?", "profile": {"employment": "casual", "industry": "hospitality"}, "expect": {"intent": "underpayment", "urgent": false, "noBareMoney": true, "contains": ["33[.,]05|26[.,]44"], "notInsufficient": true}}
{"id": "pay3", "message": "Em làm thử 2 ngày ở quán mà không được trả tiền", "expect": {"intent": "underpayment", "source": "trial", "noBareMoney": true}}
{"id": "pay4", "message": "Chủ trừ lương vì em làm vỡ đĩa", "expect": {"intent": "underpayment", "source": "deduct|trừ|pay", "noBareMoney": true}}
{"id": "pay5", "message": "Chủ trả em 15 đô một giờ tiền mặt, nói tiền mặt thì rẻ hơn", "expect": {"intent": "underpayment", "noBareMoney": true, "contains": ["26[.,]44|33[.,]05"], "notInsufficient": true}}
{"id": "pay6", "message": "Em làm chủ nhật mà vẫn nhận đúng tiền như ngày thường", "expect": {"intent": "underpayment", "source": "penalty|rate|pay", "noBareMoney": true}}
{"id": "pay7", "message": "Em làm 55 tiếng một tuần, chủ không trả thêm giờ tăng ca", "expect": {"intent": "underpayment", "noBareMoney": true}}
{"id": "pay8", "message": "chu tra em 20 do mot gio co dung khong", "note": "gõ không dấu — NLU phải hiểu được", "expect": {"intent": "underpayment", "noBareMoney": true}}
{"id": "pay9", "message": "Em làm casual, chủ nói casual không được cộng thêm đồng nào", "profile": {"employment": "casual"}, "expect": {"intent": "underpayment", "source": "casual|loading|pay", "contains": ["casual"], "noBareMoney": true}}

# ============ Không có payslip ============
{"id": "ps2", "message": "Chủ nói trả tiền mặt thì không cần payslip", "expect": {"intent": "no_payslip", "source": "pay ?slip|record", "notInsufficient": true}}
{"id": "ps3", "message": "chu khong dua payslip cho em bao gio", "note": "gõ không dấu", "expect": {"intent": "no_payslip", "source": "pay ?slip|record"}}
{"id": "ps4", "message": "Em xin bảng lương 6 tháng trước, chủ nói không lưu giữ gì cả", "expect": {"intent": "no_payslip", "source": "record|pay ?slip"}}

# ============ Visa ============
{"id": "visa1", "message": "Gọi Fair Work thì có bị huỷ visa không?", "expect": {"intent": "visa_threat", "urgent": false, "source": "visa", "notInsufficient": true}}
{"id": "visa2", "message": "Em là du học sinh, được làm bao nhiêu giờ?", "profile": {"visa": "Du học sinh (Student)"}, "note": "corpus ĐÃ có mốc 48 giờ/2 tuần (ví dụ Leon/Sam trong fwo_visa_holders) — câu này rớt là do NLU xếp nhầm contract_hours + retrieval không với tới, KHÔNG phải thiếu tài liệu", "expect": {"intent": "visa_threat", "source": "visa|migrant", "notInsufficient": true, "contains": ["48"]}}
{"id": "visa3", "message": "Chủ doạ báo di trú nếu em đòi tiền lương", "note": "bỏ ràng buộc risk: \"doạ\" là từ khoá khẩn cấp nên risk=high là đúng, kỳ vọng medium ban đầu là sai", "expect": {"intent": "visa_threat", "source": "visa|protection"}}
{"id": "visa4", "message": "Em lỡ làm quá số giờ visa cho phép, giờ đòi lương thì có bị gì không?", "note": "câu khó: phải nói được quyền lao động không phụ thuộc việc vi phạm điều kiện visa", "expect": {"intent": "visa_threat", "source": "visa|protection"}}
{"id": "visa5", "message": "Working holiday visa có được trả lương bằng người Úc không?", "profile": {"visa": "whv"}, "note": "bỏ ràng buộc intent: câu này vừa là visa vừa là lương, xếp underpayment cũng không sai", "expect": {"notInsufficient": true, "noBareMoney": true}}
{"id": "visa6", "message": "chu doa huy visa cua em neu em nghi lam", "note": "gõ không dấu", "expect": {"intent": "visa_threat"}}
{"id": "urg1", "message": "Chủ giữ hộ chiếu của em và doạ báo di trú", "expect": {"intent": "visa_threat", "urgent": true, "risk": "high"}}
{"id": "urg2", "message": "chu giu ho chieu cua em", "expect": {"urgent": true, "risk": "high"}}

