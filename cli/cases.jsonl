# ============ Sa thải  —  rag.db hiện KHÔNG có tài liệu về mảng này ============
# Các câu dưới đây sẽ FAIL cho tới khi bổ sung nguồn vào rag-pipeline/config/sources.yaml
# rồi build lại rag.db. Đó là mục đích: bộ test phải nhìn thấy lỗ hổng dữ liệu.
{"id": "dis1", "message": "Em bị đuổi việc sau khi hỏi về lương", "note": "thực chất là adverse action / general protections, không chỉ unfair dismissal", "expect": {"intent": "unfair_dismissal", "source": "dismiss|protection|ending-employment|fwc|termination", "contains": ["21"], "notInsufficient": true}}
{"id": "dis2", "message": "Em bị đuổi việc, có bao nhiêu ngày để nộp đơn khiếu nại?", "expect": {"intent": "unfair_dismissal", "contains": ["21 ngày|21 days|\\b21\\b"], "notInsufficient": true}}
{"id": "dis3", "message": "Chủ cắt hết ca làm của em sau khi em hỏi về tiền lương", "expect": {"intent": "unfair_dismissal", "source": "protection|dismiss|right"}}
{"id": "dis4", "message": "Em mới làm được 3 tháng thì bị đuổi, có khiếu nại được không?", "note": "phải nêu điều kiện làm tối thiểu 6 tháng (12 tháng nếu quán dưới 15 người)", "expect": {"intent": "unfair_dismissal", "contains": ["6 tháng|6 months|sáu tháng"], "notInsufficient": true}}
{"id": "dis5", "message": "bi duoi viec sau khi hoi ve luong", "note": "gõ không dấu", "expect": {"intent": "unfair_dismissal"}}
{"id": "dis6", "message": "Quán em chỉ có 8 người, em làm 8 tháng thì bị cho nghỉ", "expect": {"intent": "unfair_dismissal", "contains": ["12 tháng|12 months|nhỏ|small business"]}}

