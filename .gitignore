# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
data/*.db*
# rag.db do rag-pipeline tạo: PHẢI commit để Vercel có dữ liệu RAG
!data/rag.db

# Python pipeline
rag-pipeline/.venv/
rag-pipeline/data/*
!rag-pipeline/data/manual/
rag-pipeline/reports/
__pycache__/
.pytest_cache/

# báo cáo của công cụ dòng lệnh thử trợ lý
cli/reports/
